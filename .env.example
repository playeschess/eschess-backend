# Copy to .env. These match docker-compose.yml and are for local development only.
DATABASE_URL=postgres://eschess:eschess@127.0.0.1:5440/eschess
BIND=127.0.0.1:8080
RUST_LOG=info

# A custodial wallet is created for each of these assets when a player signs up (comma separated: XLM or CODE:ISSUER).
WALLET_ASSETS=XLM
# Token lifetimes in seconds: access tokens are short, refresh tokens are single use, a session ends after the maximum.
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
SESSION_MAX_SECONDS=7776000
# EMAIL. With SMTP_URL set, confirmation and password-reset emails are really sent; any provider that offers SMTP
# works (SendGrid, Mailgun, Postmark, Resend, Amazon SES, Gmail ...). The URL contains the password, so keep it in
# your secret store, never in the repo. Without SMTP_URL, emails are only written to the server log.
# SMTP_URL=smtps://username:password@smtp.yourprovider.com:465
# MAIL_FROM=eSchess <no-reply@yourdomain.com>
# Where the links in emails point (your website, or the app's link domain).
APP_BASE_URL=http://localhost:3000
# FOR YOUR OWN MACHINE ONLY: print the one-time tokens in the log so you can finish a flow without a mail server.
# Refused at startup if SMTP_URL is also set.
DEV_PRINT_EMAIL_TOKENS=false
VERIFY_LINK_SECONDS=86400
RESET_LINK_SECONDS=1800
EMAIL_COOLDOWN_SECONDS=60
# Lock an account for a while after this many wrong passwords in a row.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Live play over WebSockets. Times are in milliseconds. All are optional; these are the defaults. A value that is not
# a number, is zero, or has WS_PONG_TIMEOUT_MS no longer than WS_PING_INTERVAL_MS stops the server from starting.
# A client must say HELLO within this long of connecting.
WS_HELLO_TIMEOUT_MS=5000
# How often the server pings each connection (the round trip is how it measures lag), and how long a connection may
# go without answering before it is closed.
WS_PING_INTERVAL_MS=10000
WS_PONG_TIMEOUT_MS=30000
# How often it looks for fallen flags, re-sends clock corrections, and re-checks that each player is still signed in.
WS_TICK_MS=1000
WS_CLOCK_SYNC_MS=5000
WS_REAUTH_MS=5000
# Per-connection limits: the largest message, games watched at once, and messages per second.
WS_MAX_MESSAGE_BYTES=16384
WS_MAX_SUBSCRIPTIONS=20
WS_MAX_MESSAGES_PER_SECOND=30

# Stellar deposits (testnet only for now). Off unless STELLAR_HOT_ACCOUNT is set: the platform wallet (a plain G... account)
# that receives every player's deposits. Create and fund one on the testnet at https://lab.stellar.org, add a USDC
# trustline, and get test USDC from https://faucet.circle.com. Never use a key you care about here: only the PUBLIC
# address is configured, and the server never holds the secret key for deposits.
STELLAR_HOT_ACCOUNT=
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Circle's USDC issuer on the testnet (the default). A different issuer is a different asset.
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# How often the wallet is checked for new payments, in milliseconds (at least 500).
STELLAR_POLL_MS=5000

# Withdrawals of USDC (only while STELLAR_HOT_ACCOUNT is set), as USDC amounts. These are the defaults; the real figures
# are a product decision. Above the auto-approve amount, a person with the withdrawal_approver role must approve.
# A value that is not an amount, a zero minimum, or a daily limit below the minimum stops the server from starting.
WITHDRAW_MIN_USDC=1
WITHDRAW_AUTO_APPROVE_USDC=100
WITHDRAW_DAILY_LIMIT_USDC=1000
# Sending withdrawals (the worker, `make worker`). The hot wallet's SECRET key, in a file only its owner can read
# (chmod 600). Testnet only: a local key is refused for the public network. Without it, withdrawals wait, approved.
# STELLAR_HOT_SECRET_FILE=/path/to/hot-wallet.secret
# Fee offered per payment, in stroops of XLM (at least 100).
WITHDRAW_FEE_STROOPS=1000
# Every payment expires this many seconds after it is built; a lost one is replaced only after that (plus the margin).
WITHDRAW_TX_TIMEOUT_SECS=120
WITHDRAW_EXPIRY_MARGIN_SECS=60
# How often the worker looks for withdrawals to send, in milliseconds.
WITHDRAW_SEND_POLL_MS=2000

# Fair play (the worker scores finished games; ADR 0002). This repository's scorer gives everyone 0; the private
# eschess-fairplay repository builds a worker with the real one. A score at or above the threshold (1 to 100) opens a
# review case. A value that is not a valid number stops the worker from starting.
FAIRPLAY_CASE_THRESHOLD=70
# Games scored per round, and how often a round runs (milliseconds).
FAIRPLAY_BATCH=50
FAIRPLAY_POLL_MS=10000

# Staked games (ADR 0004), testnet only until the legal review is done. Off unless set and Stellar is on. A comma-separated
# list of the USDC amounts a game may be staked at; nobody types a stake freely.
STAKES_USDC=

# Settling staked games (ADR 0004 §5). Off unless SETTLE_SCORER names the fair-play scorer whose verdict a game must have
# before its pot moves, e.g. baseline-1 (the private worker's scorer). With none set, finished staked games just wait.
SETTLE_SCORER=
# The platform's cut of a decisive pot, in basis points (100 = 1%), at most 2000. Draws and returned stakes pay none.
STAKE_FEE_BPS=0

# Players' own wallets (ADR 0006), testnet only. A file holding the master key that seals each player's wallet key, as 64
# hexadecimal characters, readable only by you (chmod 600). Make one with: openssl rand -hex 32 > ~/.eschess-testnet/master.key
# Unset: players get no wallet of their own. Never use a file like this on the public network; that needs a key service.
WALLET_MASTER_KEY_FILE=
# The platform's funding account (testnet): pays the starting XLM for each player's own account. A secret-seed file like
# STELLAR_HOT_SECRET_FILE, chmod 600. Needs WALLET_MASTER_KEY_FILE too. XLM each new account starts with (at least 1.5):
WALLET_FUNDER_SECRET_FILE=
WALLET_FUNDING_XLM=2

# The books-against-chain check (worker): how often to compare the ledger with the network (seconds, at least 30), and how
# many mismatches in a row halt new withdrawals and staked games until a person clears it.
RECONCILE_INTERVAL_SECS=300
RECONCILE_MISMATCHES_TO_HALT=3

# Staking on the escrow contract (ADR 0007), testnet only. All three, plus WALLET_MASTER_KEY_FILE, turn on the job that locks
# stakes in the contract. The contract address, and the key file of its admin (a secret-seed file, chmod 600):
ESCROW_CONTRACT=
ESCROW_ADMIN_SECRET_FILE=
# Optional: where to reach the Soroban RPC server (the testnet one is the default).
SOROBAN_RPC_URL=
# New staked games are made on the ledger path (default) or the contract path; change it with SQL:
#   UPDATE platform_settings SET value = 'contract' WHERE name = 'stake_path';

# Linking a player's Lichess account (ADR 0005). Off unless LICHESS_REDIRECT_URI is set: the page of the web app that
# Lichess sends the player back to (https://, or http://localhost for development). Lichess needs no registration for
# this kind of login; the client id is any unique name. We ask for no permissions and end the token straight away.
# LICHESS_REDIRECT_URI=http://localhost:3000/lichess
# LICHESS_CLIENT_ID=eschess
